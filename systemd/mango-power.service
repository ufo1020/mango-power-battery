[Unit]
Description=Mango Power M local poller
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/mango-power.env
ExecStart=/usr/bin/python3 /opt/mango-power-battery/local_poll.py
Restart=on-failure
RestartSec=10
User=nobody

[Install]
WantedBy=multi-user.target
